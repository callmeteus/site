---
import type { LinkLanguage } from "../config/links";
import FlagIcon from "./FlagIcon.astro";
import { getFlagLabel } from "../utils/flags";

interface Props {
    languages: LinkLanguage[];
}

const { languages } = Astro.props;
---

<div class="flex shrink-0 items-center gap-1.5" aria-label={languages.map((l) => getFlagLabel(l)).join(", ")}>
    {languages.map((lang) => (
        <span title={getFlagLabel(lang)}>
            <span class="sr-only">{getFlagLabel(lang)}</span>
            <FlagIcon lang={lang} size={16} />
        </span>
    ))}
</div>
