---
import { site } from "../config/site";
import BrandIcon from "./Icon.astro";
import LangBadge from "./LangBadge.astro";
import { Copy, Check } from "@lucide/astro";
---

<button
    type="button"
    id="pix-copy-btn"
    data-pix-key={site.pixKey}
    class="surface-card surface-card-hover group flex min-h-[4.5rem] w-full cursor-pointer items-center gap-4 p-4 text-left"
>
    <span class="sr-only">Copy Pix key</span>
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-border bg-white/[0.03] text-[#32BCAD]">
        <BrandIcon name="simple-icons:pix" size={20} />
    </span>
    <span class="min-w-0 flex-1">
        <span class="block text-[0.9375rem] font-semibold leading-snug text-ink">Pix</span>
        <span class="mt-0.5 block truncate text-sm leading-snug text-muted">{site.pixKey}</span>
    </span>
    <span class="flex shrink-0 items-center gap-3">
        <LangBadge languages={["pt"]} />
        <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-border bg-white/[0.03] text-muted">
            <Copy size={16} id="pix-icon-copy" aria-hidden="true" />
            <Check size={16} id="pix-icon-check" class="hidden text-accent" aria-hidden="true" />
        </span>
    </span>
</button>
<p id="pix-feedback" class="mt-2 hidden text-center text-sm font-medium text-accent" role="status">
    Copied!
</p>

<script>
    const btn = document.getElementById("pix-copy-btn");
    const feedback = document.getElementById("pix-feedback");
    const iconCopy = document.getElementById("pix-icon-copy");
    const iconCheck = document.getElementById("pix-icon-check");

    btn?.addEventListener("click", async () => {
        const key = btn.getAttribute("data-pix-key");
        if (!key) return;

        try {
            await navigator.clipboard.writeText(key);
            feedback?.classList.remove("hidden");
            iconCopy?.classList.add("hidden");
            iconCheck?.classList.remove("hidden");
            window.setTimeout(() => {
                feedback?.classList.add("hidden");
                iconCopy?.classList.remove("hidden");
                iconCheck?.classList.add("hidden");
            }, 2000);
        } catch {
            feedback!.textContent = "Could not copy. Select manually.";
            feedback?.classList.remove("hidden");
        }
    });
</script>
