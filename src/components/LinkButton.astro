---
import type { SiteLink } from "../config/links";
import BrandIcon from "./Icon.astro";
import LangBadge from "./LangBadge.astro";
import { ArrowUpRight } from "@lucide/astro";

interface Props {
    link: SiteLink;
}

const { link } = Astro.props;
---

<a
    href={link.href}
    class="surface-card surface-card-hover group flex min-h-[4.5rem] items-center gap-4 p-4"
    target={link.external ? "_blank" : undefined}
    rel={link.external ? "noopener noreferrer" : undefined}
>
    <span
        class:list={[
            "flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-border bg-tile",
            link.accentClass,
        ]}
    >
        <BrandIcon name={link.icon} size={20} />
    </span>
    <span class="min-w-0 flex-1">
        <span class="block text-[0.9375rem] font-semibold leading-snug text-ink">
            {link.label}
        </span>
        {link.description && (
            <span class="mt-0.5 block text-sm leading-snug text-muted">
                {link.description}
            </span>
        )}
    </span>
    <span class="flex shrink-0 items-center gap-3">
        <LangBadge languages={link.languages} />
        {link.external && (
            <ArrowUpRight
                size={16}
                class="text-faint transition-colors group-hover:text-ink"
                aria-hidden="true"
            />
        )}
    </span>
</a>
