---
import { stackFilters, stackGroups } from "../../config/stack";
import TechIcon from "../TechIcon.astro";
import ChapterLabel from "./ChapterLabel.astro";
---

<section id="toolbox" class="scroll-reveal scroll-mt-16 px-4 py-16 sm:px-6 sm:py-20">
    <div class="mx-auto max-w-5xl">
        <ChapterLabel number="02" label="THE TOOLBOX" />

        <h2 class="font-display text-[clamp(2rem,5vw,3rem)] font-medium leading-[1.08] tracking-tight text-ink">
            things I work <span class="name-mark">with</span>
        </h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted">
            Languages, infrastructure, embedded systems and the creative tools I use away from the code.
        </p>

        <div class="mt-7 flex flex-wrap gap-2" role="group" aria-label="Filter tools by category">
            {stackFilters.map((filter, index) => (
                <button
                    type="button"
                    class="filter-btn"
                    data-filter={filter.id}
                    class:list={index === 0 && "is-active"}
                    aria-pressed={index === 0 ? "true" : "false"}
                >
                    {filter.label}
                </button>
            ))}
        </div>

        <div class="mt-8 flex flex-col gap-6">
            {stackGroups.map((group) => (
                <div
                    class="grid gap-3 sm:grid-cols-[11rem_1fr] sm:gap-5"
                    data-group={group.id}
                >
                    <p class:list={[
                        "font-mono text-[11px] font-medium uppercase tracking-[0.12em]",
                        group.highlight ? "text-accent" : "text-faint",
                    ]}>
                        {group.label}
                    </p>
                    <div class="flex flex-wrap gap-2">
                        {group.items.map((item) => (
                            <span class:list={[
                                "inline-flex items-center gap-2 rounded-full border px-3 py-1.5 font-mono text-xs font-medium",
                                group.highlight
                                    ? "border-accent/30 bg-accent-soft text-accent"
                                    : "border-border bg-tile text-muted",
                            ]}>
                                <TechIcon name={item.icon} size={14} />
                                {item.name}
                            </span>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<script>
    const buttons = [...document.querySelectorAll<HTMLButtonElement>("#toolbox .filter-btn")];
    const groups = [...document.querySelectorAll<HTMLElement>("#toolbox [data-group]")];

    buttons.forEach((button) => {
        button.addEventListener("click", () => {
            const filter = button.dataset.filter;

            buttons.forEach((btn) => {
                const active = btn === button;
                btn.classList.toggle("is-active", active);
                btn.setAttribute("aria-pressed", active ? "true" : "false");
            });

            groups.forEach((group) => {
                group.style.display =
                    filter === "all" || group.dataset.group === filter ? "" : "none";
            });
        });
    });
</script>
