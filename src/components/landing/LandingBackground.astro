---
// A small night scene for the top of the page: sky, stars, crescent moon and a treeline.
const stars = Array.from({ length: 90 }, (_, i) => ({
    x: (i * 37.7) % 100,
    y: (i * 61.3) % 82,
    size: i % 9 === 0 ? 3 : i % 4 === 0 ? 2 : 1.4,
    o: 0.3 + ((i * 13) % 60) / 100,
    glow: 4 + (i % 5) * 2,
    dur: 3 + (i % 7),
    delay: (i % 11) * 0.4,
}));

const trees = Array.from({ length: 40 }, (_, i) => ({
    x: i * 40 + ((i * 17) % 22) - 12,
    w: 30 + (i % 5) * 9,
    h: 55 + ((i * 29) % 95),
    o: 0.78 + (i % 4) * 0.06,
}));
---

<div class="pointer-events-none absolute inset-x-0 top-0 z-0 h-[820px] overflow-hidden" aria-hidden="true">
    <div class="sky-gradient absolute inset-0"></div>

    <div class="stars absolute inset-0">
        {stars.map((star) => (
            <span
                class="bg-star absolute rounded-full"
                style={`left:${star.x}%; top:${star.y}%; width:${star.size}px; height:${star.size}px; --o:${star.o}; box-shadow:0 0 ${star.glow}px ${star.size / 2}px rgb(232 245 192 / 0.5); animation:twinkle ${star.dur}s ease-in-out ${star.delay}s infinite;`}
            ></span>
        ))}
    </div>

    <div class="moon absolute right-[10%] top-[9%] h-24 w-24 sm:right-[14%] sm:top-[11%] sm:h-32 sm:w-32">
        <svg viewBox="0 0 100 100" class="h-full w-full" aria-hidden="true">
            <defs>
                <mask id="moon-crescent">
                    <rect width="100" height="100" fill="white"></rect>
                    <circle cx="64" cy="36" r="41" fill="black"></circle>
                </mask>
            </defs>
            <circle cx="50" cy="50" r="42" class="fill-moon" mask="url(#moon-crescent)"></circle>
        </svg>
    </div>

    <div class="sun absolute right-[11%] top-[10%] h-24 w-24 sm:right-[15%] sm:top-[12%] sm:h-32 sm:w-32"></div>

    <div class="sparkles absolute inset-0">
        {[
            { x: 18, y: 24, s: 18, d: 0 },
            { x: 71, y: 16, s: 14, d: 1.2 },
            { x: 88, y: 48, s: 16, d: 2.1 },
            { x: 33, y: 62, s: 12, d: 0.6 },
            { x: 58, y: 8, s: 11, d: 1.8 },
            { x: 8, y: 44, s: 13, d: 2.6 },
        ].map((spark) => (
            <svg
                class="absolute text-accent"
                style={`left:${spark.x}%; top:${spark.y}%; width:${spark.s}px; height:${spark.s}px; --o:0.85; animation:twinkle ${4 + spark.d}s ease-in-out ${spark.d}s infinite;`}
                viewBox="0 0 24 24"
                fill="currentColor"
            >
                <path d="M12 0 L14 10 L24 12 L14 14 L12 24 L10 14 L0 12 L10 10 Z"></path>
            </svg>
        ))}
    </div>

    <svg
        class="absolute inset-x-0 bottom-0 h-[220px] w-full"
        viewBox="0 0 1440 220"
        preserveAspectRatio="none"
        aria-hidden="true"
    >
        <rect x="0" y="205" width="1440" height="15" class="fill-tree"></rect>
        {trees.map((tree) => (
            <polygon
                points={`${tree.x},220 ${tree.x + tree.w / 2},${220 - tree.h} ${tree.x + tree.w},220`}
                class="fill-tree"
                opacity={tree.o}
            ></polygon>
        ))}
    </svg>

    <div class="sky-fade absolute inset-x-0 bottom-0 h-32"></div>
</div>
