---
import type { Project } from "../../config/projects";
import { projects } from "../../config/projects";
import { ArrowUpRight, Sparkles } from "@lucide/astro";
import ChapterLabel from "./ChapterLabel.astro";

interface Props {
    items?: Project[];
}

const { items = projects } = Astro.props;

const host = (href: string) =>
    href.replace(/^https?:\/\//, "").replace(/^www\./, "").split("/")[0];

const actionLabel = (href: string) =>
    href.includes("github.com") ? "Open on GitHub" : "Visit site";
---

{items.length > 0 && (
    <section id="projects" class="scroll-reveal scroll-mt-16 px-4 py-16 sm:px-6 sm:py-20">
        <div class="mx-auto max-w-5xl">
            <ChapterLabel number="02" label="THE WORKSHOP" />

            <h2 class="font-display text-[clamp(2rem,5vw,3rem)] font-medium leading-[1.08] tracking-tight text-ink">
                things i've <span class="name-mark">built</span>
            </h2>
            <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted">
                A few projects that came out of the workshop. Some are still growing.
            </p>

            <div class="mt-8 flex flex-col gap-4">
                {items.map((project, index) => (
                    <a
                        href={project.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group grid overflow-hidden rounded-2xl border border-border bg-surface-raised transition-colors hover:border-accent/40 md:grid-cols-2"
                    >
                        <div class="flex flex-col p-6 sm:p-8">
                            {index === 0 && (
                                <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-accent-soft px-3 py-1 font-mono text-[11px] font-semibold tracking-[0.1em] text-accent">
                                    <Sparkles size={12} aria-hidden="true" />
                                    FEATURED
                                </span>
                            )}
                            <h3 class:list={[
                                "font-display text-2xl font-semibold tracking-tight text-ink transition-colors group-hover:text-accent sm:text-3xl",
                                index === 0 && "mt-5",
                            ]}>
                                {project.title}
                            </h3>
                            <p class="mt-3 text-sm leading-relaxed text-muted">
                                {project.description}
                            </p>
                            <div class="mt-5 flex flex-wrap gap-2">
                                {project.tags.map((tag) => (
                                    <span class="rounded-full border border-border bg-tile px-2.5 py-1 font-mono text-[11px] text-muted">
                                        {tag}
                                    </span>
                                ))}
                            </div>
                            <span class="btn btn-primary mt-7 w-fit">
                                {actionLabel(project.href)}
                                <ArrowUpRight size={16} aria-hidden="true" />
                            </span>
                        </div>
                        <div class="flex flex-col justify-center border-t border-border bg-terminal p-6 font-mono text-xs leading-7 text-terminal-text sm:p-8 md:border-l md:border-t-0">
                            <p class="text-faint">$ project --info {project.id}</p>
                            <p>stack &nbsp;&nbsp; {project.tags.join(" · ")}</p>
                            <p>scope &nbsp; {project.scope}</p>
                            <p>link &nbsp;&nbsp;&nbsp; {host(project.href)}</p>
                            <p class="mt-3 text-accent">
                                &gt; always tinkering<span class="animate-pulse">_</span>
                            </p>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    </section>
)}
