---
interface Props {
    title: string;
    subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="mb-5">
    <div class="section-rule mb-2">
        <h2 class="font-display text-xl font-semibold tracking-tight text-ink sm:text-2xl">
            {title}
        </h2>
    </div>
    {subtitle && (
        <p class="text-sm leading-relaxed text-muted">
            {subtitle}
        </p>
    )}
</div>
