---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not Found" description="Page not found.">
    <section class="flex min-h-[50vh] flex-col items-center justify-center px-4 py-16 text-center">
        <h1 class="font-display text-[clamp(3rem,10vw,5rem)] font-medium leading-none text-ink">404</h1>
        <p class="mt-4 text-muted">This page doesn't exist.</p>
        <a
            href="/"
            class="mt-8 inline-flex min-h-11 items-center rounded-lg bg-accent px-6 font-semibold text-surface transition-colors hover:bg-accent/90"
        >
            Go home
        </a>
    </section>
</BaseLayout>
