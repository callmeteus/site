---
import LandingLayout from "../layouts/LandingLayout.astro";
import LandingBackground from "../components/landing/LandingBackground.astro";
import LandingHero from "../components/landing/LandingHero.astro";
import AboutSection from "../components/landing/AboutSection.astro";
import FocusStrip from "../components/landing/FocusStrip.astro";
import LinkSection from "../components/landing/LinkSection.astro";
import ProjectsSection from "../components/landing/ProjectsSection.astro";
import BlogTeaser from "../components/landing/BlogTeaser.astro";
import EventsSection from "../components/landing/EventsSection.astro";
import LandingFooter from "../components/landing/LandingFooter.astro";
---

<LandingLayout>
    <LandingBackground />
    <div class="relative z-10">
        <LandingHero />
        <div class="dot-grid">
            <AboutSection />
            <FocusStrip />
            <LinkSection group="social" id="connect" />
            <LinkSection group="support" />
            <LinkSection group="telegram" />
            <ProjectsSection />
            <BlogTeaser />
            <EventsSection />
        </div>
        <LandingFooter />
    </div>
</LandingLayout>
