---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
    title="Blog"
    description="Micro tech blog: game modding, dev notes, and project writeups."
>
    <section class="px-4 py-12 sm:px-6 sm:py-16">
        <div class="mx-auto max-w-3xl">
            <header class="mb-10">
                <h1 class="font-display text-[clamp(2.25rem,6vw,3rem)] font-medium tracking-tight text-ink">
                    Blog
                </h1>
                <p class="mt-3 text-muted">
                    Notes on code, game modding, and things I'm building.
                </p>
            </header>

            {posts.length > 0 ? (
                <ul class="flex flex-col gap-3">
                    {posts.map((post) => (
                        <li>
                            <a
                                href={`/blog/${post.id}`}
                                class="surface-card surface-card-hover group block p-5"
                            >
                                <time
                                    datetime={post.data.date.toISOString()}
                                    class="text-xs text-faint tabular-nums"
                                >
                                    {post.data.date.toLocaleDateString("en-US", {
                                        month: "long",
                                        day: "numeric",
                                        year: "numeric",
                                    })}
                                </time>
                                <h2 class="mt-1 font-display text-xl font-semibold leading-snug text-ink transition-colors group-hover:text-accent">
                                    {post.data.title}
                                </h2>
                                <p class="mt-2 text-sm leading-relaxed text-muted">
                                    {post.data.description}
                                </p>
                                {post.data.tags.length > 0 && (
                                    <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1">
                                        {post.data.tags.map((tag) => (
                                            <li class="text-xs text-faint">{tag}</li>
                                        ))}
                                    </ul>
                                )}
                            </a>
                        </li>
                    ))}
                </ul>
            ) : (
                <p class="py-16 text-center text-muted">No posts yet. Check back soon.</p>
            )}
        </div>
    </section>
</BaseLayout>
